# Sem dominio definitivo, o site permanece como previa sem indexacao.
# SITE_URL=https://dominio-aprovado.example
# SITE_INDEXABLE=true

# Apenas para prévia privada de produção local, sem SITE_URL.
# Nunca habilitar esta opção em um servidor público.
# SITE_PREVIEW_DRAFTS=true

# VPS com Traefik: copiar deploy/production.env.example para .env.production.
# Usar docker compose --env-file .env.production; ver docs/PRODUCAO-VPS.md.

# IDs públicos opcionais, lidos no servidor em runtime. Não enviar tokens de API.
# Sem IDs, nenhuma tag de medição é carregada, mesmo após aceitar cookies.
GA4_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_WHATSAPP_LABEL=
META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
